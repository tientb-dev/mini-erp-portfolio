# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (docker-compose)
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_erp
POSTGRES_PORT=5442
DATABASE_URL=postgresql://mini_erp:change-me@localhost:5442/mini_erp
TEST_DATABASE_URL=postgresql://mini_erp:change-me@localhost:5442/mini_erp_test

# API
API_PORT=3100
CORS_ORIGIN=http://localhost:5180
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=8h
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
SEED_APPROVER_USERNAME=approver
SEED_APPROVER_PASSWORD=change-me-approver
# Optional: creates role users sales / pm / purchaser / warehouse with this password (local demo only)
SEED_ROLE_USERS_PASSWORD=change-me-users

# Web
VITE_API_BASE_URL=http://localhost:3100
