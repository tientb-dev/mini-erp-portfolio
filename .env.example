# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (docker-compose)
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_erp
POSTGRES_PORT=5442
DATABASE_URL=postgresql://mini_erp:change-me@localhost:5442/mini_erp
TEST_DATABASE_URL=postgresql://mini_erp:change-me@localhost:5442/mini_erp_test

# API
API_PORT=3100
CORS_ORIGIN=http://localhost:5180

# Private PR dossier files. Default is .local/dossiers relative to the repo root.
# DOSSIER_STORAGE_DIR=/srv/mini-erp/dossiers
# DOSSIER_MAX_FILE_BYTES=20971520
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=8h
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
# Test fixtures only. Dev seed creates just the bootstrap ADMIN.
SEED_APPROVER_USERNAME=approver
SEED_APPROVER_PASSWORD=change-me-approver
# OA2.3a: employee codes of seeded admin/approver (defaults ADMIN, APPROVER).
# SEED_ADMIN_EMPLOYEE_CODE=ADMIN
# SEED_APPROVER_EMPLOYEE_CODE=APPROVER
# OA2.3a upgrade only: JSON {"<username>": "<employee code>"} for every existing user; the migration stops otherwise.
# EMPLOYEE_CODES={"admin":"ADMIN","approver":"APPROVER"}
# Password for test fixture business-role users.
SEED_ROLE_USERS_PASSWORD=change-me-users

# Web
VITE_API_BASE_URL=http://localhost:3100
